# space ocr — API key. Copy to `.env` and drop in your real key.
# Get one at https://space-ocr.com -> Settings -> API Keys (100 free scans, no card).
SPACE_OCR_API_KEY=spocr_your_key_here

# Optional: override the API base (defaults to https://api.space-ocr.com).
# SPACE_OCR_API_BASE=https://api.space-ocr.com